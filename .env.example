# ─────────────────────────────────────────────────────────────────────
# Nova Analytics — environment variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values:
#
#     cp .env.example .env.local
#
# .env.local is gitignored and will never be committed.
# ─────────────────────────────────────────────────────────────────────


# ─── Database (Postgres) ─────────────────────────────────────────────
# Nova uses Prisma to talk to Postgres. We recommend Supabase Postgres
# (free tier, 5-min setup) but ANY Postgres host works.
#
# IMPORTANT: when using Supabase or another PgBouncer-pooled host you
# need TWO connection strings — one for the app (pooler, port 6543)
# and one for migrations (direct connection, port 5432).
#
# How to get them from Supabase:
#   Dashboard → Connect (top of page) → ORMs → Prisma
#   Then replace [YOUR-PASSWORD] with your real DB password.
#
# To isolate Nova's tables in their own schema (recommended if you're
# sharing a Supabase project across multiple apps), do this once in
# the Supabase SQL editor:
#
#     CREATE SCHEMA IF NOT EXISTS nova_analytics;
#
# Then append BOTH of these to the URLs:
#     &schema=nova_analytics
#     &options=-c%20search_path%3Dnova_analytics
#
# (the search_path option is required because the analytics
#  aggregations use raw SQL queries, which don't honor Prisma's
#  ?schema= parameter on their own.)

# Pooler URL — used by the running app (Vercel serverless functions).
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=nova_analytics&options=-c%20search_path%3Dnova_analytics"

# Direct connection — used ONLY by `prisma migrate`. Migrations need a
# non-pooled connection because they take advisory locks.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?schema=nova_analytics&options=-c%20search_path%3Dnova_analytics"


# ─── App secrets ──────────────────────────────────────────────────────
# Used to sign Nova's JWT auth tokens. Generate a strong random string
# for production. On macOS / Linux you can run:
#
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# DO NOT use the placeholder below in production.
HASH_SALT="change-me-to-a-long-random-string-in-production"


# ─── Optional flags ───────────────────────────────────────────────────
# Disable telemetry pings and version-update checks (Nova doesn't phone
# home in this fork, but these flags belt-and-brace it).
DISABLE_TELEMETRY="1"
DISABLE_UPDATES="1"

# Disable the public login page entirely (admin can still create users
# from the admin panel). Leave commented out for normal use.
# DISABLE_LOGIN="1"

# Disable the entire UI (the API still runs). For headless deployments.
# DISABLE_UI="1"
